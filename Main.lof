\contentsline {figure}{\numberline {5.1}{\ignorespaces Experimental setup used to detect Hanle resonance}}{38}{figure.caption.58}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Lorentzian profiles when (a) $B_z$ is varied and $B_y = 0$, (b) $B_y$ is varied and $B_z = 0$, and (c) $B_y$ and $B_z$ are varied simultaneously}}{39}{figure.caption.59}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Raw data and Lorentzian fit of the Hanle resonance obtained for the optimal DC field configuration ($B_y = \SI {0}{\nano \tesla }$, $B_z = \SI {4815}{\nano \tesla }$)}}{40}{figure.caption.60}%
