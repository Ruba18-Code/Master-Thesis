\contentsline {figure}{\numberline {4.1}{\ignorespaces Example of the probe of an Atomic Force Microscope. From \blx@tocontentsinit {0}\cite {wiki_afm_tip}.}}{24}{figure.caption.38}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces 2D Surface images obtained through AFM in three different parts of the pristine Nanoquartz disk's surface.}}{25}{figure.caption.39}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces 3D Surface images obtained through AFM in three different parts of the pristine Nanoquartz disk's surface.}}{26}{figure.caption.40}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Surface roughness distribution obtained through AFM. It can be seen that most of the defects are below the \SI {1}{\nano \meter } range. Furthermore, the mean ($\mu $) is close to zero, confirming that the surface is uniform.}}{26}{figure.caption.41}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Geometrical definition of the contact angle $\theta _C$ at the three-phase boundary between a liquid droplet, the ambient gas, and the solid substrate. The equilibrium value is set by the balance of interfacial energies expressed in Young's equation (Eq.~\eqref {eq:young}). From \blx@tocontentsinit {0}\cite {wikicontact}.}}{27}{figure.caption.43}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Representative contact angle regimes across different wettability states. Surface~A ($\theta _C > 90^\circ $) is hydrophobic; surfaces~B, C, and~D are sorted from partially to fully hydrophilic ($\theta _C \to 0^\circ $). From \blx@tocontentsinit {0}\cite {wikicontacts}.}}{28}{figure.caption.44}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Examples of Newton rings formed in the interphase of Si/Si wafers. From \blx@tocontentsinit {0}\cite {nrings}.}}{29}{figure.caption.45}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Illustration of the razor blade method. A razor blade is inserted between the bonded surfaces in order to quantify the bonding energy between them. From \blx@tocontentsinit {0}\cite {mack1997}.}}{29}{figure.caption.46}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Schematic representation of water stress corrosion at the hydrophilic bonding interface during debonding under controlled atmospheres. Left: wet atmosphere showing ambient water attack on Si--O--Si bonds. Center: anhydrous (dry) atmosphere with reduced water availability. Right: vacuum conditions with partial desorption of interfacial water. Adapted from \blx@tocontentsinit {0}\cite {takeuchi2022}.}}{31}{figure.caption.51}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Schematic diagram of the tensile test setup for bonding strength measurement. The bonded wafer pair is glued to metal fixtures and subjected to perpendicular tensile force. Adapted from \blx@tocontentsinit {0}\cite {gosele2006}.}}{32}{figure.caption.53}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Energy level diagram showing the D1 and D2 transitions in an alkali metal atom. From \blx@tocontentsinit {0}\cite {shi2019}}}{34}{figure.caption.57}%
