\contentsline {figure}{\numberline {3.1}{\ignorespaces Bonding process of two Fused Silica surfaces. Initially, hydrogen bonds are formed between them due to the presence of Silanol (Si-OH) groups. These bonds are subsequently transformed into stronger covalent bonds through thermal treatment. From \blx@tocontentsinit {0}\cite {gosele2006}.}}{9}{figure.caption.4}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Effects of plasma treatment on silica surfaces. Plasma helps to remove contaminants while increasing the number of available silanol groups. Adapted from \blx@tocontentsinit {0}\cite {yu2023}.}}{10}{figure.caption.5}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Bonding energy evolution with time. From \blx@tocontentsinit {0}\cite {cho2001}}}{12}{figure.caption.6}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Effects of pressure in the bonding process. Interface voids can be prevented by applying forces in the direction perpendicular to the interface. From \blx@tocontentsinit {0}\cite {mai2015}}}{13}{figure.caption.7}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Setup described by Birckigt et al. \blx@tocontentsinit {0}\cite {birckigt2021}}}{13}{figure.caption.8}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Comparison of the permeability constant $K$ across uncoated borofloat, uncoated aluminosilicate, Al$_{2}$O$_{3}$-coated borofloat, and Al$_{2}$O$_{3}$-coated aluminosilicate glasses. From \blx@tocontentsinit {0}\cite {carle2023}.}}{15}{figure.caption.9}%
