\contentsline {figure}{\numberline {3.1}{\ignorespaces Bonding process of two fused silica surfaces. Silanol ($\mathrm {Si\text {-}OH}$) groups initially form hydrogen bonds across the interface; subsequent thermal treatment converts these into permanent covalent Si-O-Si bonds. From \blx@tocontentsinit {0}\cite {gosele2006}.}}{9}{figure.caption.11}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Effects of plasma treatment on silica surfaces. Plasma removes contaminants and increases the density of available silanol groups. Adapted from \blx@tocontentsinit {0}\cite {yu2023}.}}{10}{figure.caption.12}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Evolution of bonding energy with annealing time. Bond strength follows a logarithmic growth law; annealing reduces the characteristic time constant $\mu $, accelerating convergence toward the bulk fracture energy. From \blx@tocontentsinit {0}\cite {cho2001}.}}{12}{figure.caption.13}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Effect of applied pressure on the bonding process. Forces perpendicular to the interface suppress void formation by closing residual gaps between surface asperities. From \blx@tocontentsinit {0}\cite {mai2015}.}}{13}{figure.caption.14}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Pressure plate geometry described by Birckigt et al. \blx@tocontentsinit {0}\cite {birckigt2021}. The curved profiles guide contact front propagation outward from the center, reducing the probability of interface void formation.}}{14}{figure.caption.15}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Comparison of the permeability constant $K$ across uncoated borofloat, uncoated aluminosilicate, Al$_{2}$O$_{3}$-coated borofloat, and Al$_{2}$O$_{3}$-coated aluminosilicate glasses. From \blx@tocontentsinit {0}\cite {carle2023}.}}{15}{figure.caption.16}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Newton rings being formed on the interfase of a SiN-glass wafer. From \blx@tocontentsinit {0}\cite {pasternak2018}.}}{18}{figure.caption.17}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Schematic representation of water stress corrosion at the hydrophilic bonding interface during debonding under controlled atmospheres. Left: wet atmosphere showing ambient water attack on Si--O--Si bonds. Center: anhydrous (dry) atmosphere with reduced water availability. Right: vacuum conditions with partial desorption of interfacial water. Adapted from \blx@tocontentsinit {0}\cite {takeuchi2022}.}}{19}{figure.caption.22}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Schematic diagram of the tensile test setup for bonding strength measurement. The bonded wafer pair is glued to metal fixtures and subjected to perpendicular tensile force. Adapted from \blx@tocontentsinit {0}\cite {gosele2006}.}}{20}{figure.caption.24}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces View of cantilever in Atomic Force Microscope (magnification 1000x) \blx@tocontentsinit {0}\cite {wiki_afm_tip}}}{22}{figure.caption.28}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces 2D Surface images obtained through AFM in three different parts of the pristine Nanoquartz disk's surface.}}{23}{figure.caption.29}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces 3D Surface images obtained through AFM in three different parts of the pristine Nanoquartz disk's surface.}}{24}{figure.caption.30}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Surface roughness distribution obtained through AFM. It can be seen that most of the defects are below the \SI {1}{\nano \meter } range. Furthermore, the mean ($\mu $) is close to zero, confirming that the surface is uniform.}}{24}{figure.caption.31}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Energy level diagram showing the D1 and D2 transitions in an alkali metal atom. From \blx@tocontentsinit {0}\cite {shi2019}}}{25}{figure.caption.33}%
