\contentsline {figure}{\numberline {3.1}{\ignorespaces Fabrication worklow of a Laser-Written Vapor Cell. Steps (1-2) describe the FLICE process. In step (4) NEG dispenser placement and bonding are performed. Activation is illustrated by step (5). From \blx@tocontentsinit {0}\cite {lucivero2022}.}}{5}{figure.caption.6}%
\contentsline {figure}{\numberline {3.2}{\ignorespaces Laser-Written Vapor Cell manufactured using the FLICE technique. It consists of a cylindrical reservoir (5~mm diameter, 3.5~mm height) connected to a rectangular parallelepiped sensing channel ($1 \times 1$~mm cross-section, 9.5~mm length). From \blx@tocontentsinit {0}\cite {lucivero2022}}}{9}{figure.caption.11}%
\contentsline {figure}{\numberline {3.3}{\ignorespaces Bonding process of two fused silica surfaces. Silanol ($\mathrm {Si\text {-}OH}$) groups initially form hydrogen bonds across the interface; subsequent thermal treatment converts these into permanent covalent Si-O-Si bonds. From \blx@tocontentsinit {0}\cite {gosele2006}.}}{14}{figure.caption.19}%
\contentsline {figure}{\numberline {3.4}{\ignorespaces Effects of plasma treatment on silica surfaces. Plasma removes contaminants and increases the density of available silanol groups. Adapted from \blx@tocontentsinit {0}\cite {yu2023}.}}{15}{figure.caption.20}%
\contentsline {figure}{\numberline {3.5}{\ignorespaces Evolution of bonding energy with annealing time. Bond strength follows a logarithmic growth law; annealing reduces the characteristic time constant $\mu $, accelerating convergence toward the bulk fracture energy. From \blx@tocontentsinit {0}\cite {cho2001}.}}{16}{figure.caption.21}%
\contentsline {figure}{\numberline {3.6}{\ignorespaces Effect of applied pressure on the bonding process. Forces perpendicular to the interface suppress void formation by closing residual gaps between surface asperities. From \blx@tocontentsinit {0}\cite {mai2015}.}}{17}{figure.caption.22}%
\contentsline {figure}{\numberline {3.7}{\ignorespaces Pressure plate geometry described by Birckigt et al.\ \blx@tocontentsinit {0}\cite {birckigt2021}. The curved profiles guide contact front propagation outward from the center, reducing the probability of interface void formation.}}{18}{figure.caption.23}%
\contentsline {figure}{\numberline {3.8}{\ignorespaces Comparison of the permeability constant $K$ across uncoated borofloat, uncoated aluminosilicate, Al$_{2}$O$_{3}$-coated borofloat, and Al$_{2}$O$_{3}$-coated aluminosilicate glasses. From \blx@tocontentsinit {0}\cite {carle2023}.}}{18}{figure.caption.24}%
\contentsline {figure}{\numberline {3.9}{\ignorespaces DIW}}{19}{figure.caption.25}%
\contentsline {figure}{\numberline {3.10}{\ignorespaces Acetone}}{19}{figure.caption.26}%
\contentsline {figure}{\numberline {3.11}{\ignorespaces Ethanol}}{20}{figure.caption.27}%
\contentsline {figure}{\numberline {3.12}{\ignorespaces Soap}}{20}{figure.caption.28}%
