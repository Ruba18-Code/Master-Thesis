\contentsline {figure}{\numberline {4.1}{\ignorespaces Example of the probe of an Atomic Force Microscope. From \blx@tocontentsinit {0}\cite {wiki_afm_tip}.}}{22}{figure.caption.31}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces 2D Surface images obtained through AFM in three different parts of the pristine Nanoquartz disk's surface.}}{23}{figure.caption.32}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces 3D Surface images obtained through AFM in three different parts of the pristine Nanoquartz disk's surface.}}{24}{figure.caption.33}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Surface roughness distribution obtained through AFM. It can be seen that most of the defects are below the \SI {1}{\nano \meter } range. Furthermore, the mean ($\mu $) is close to zero, confirming that the surface is uniform.}}{24}{figure.caption.34}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces A diagram that shows the contact angle and interphase-energy between 3 phases (gas, liquid, solid). From \blx@tocontentsinit {0}\cite {wikicontact}.}}{25}{figure.caption.36}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Diagram of different contact angles. A corresponds to an hydrophobic surface. Surfaces B, C and S are sorted from less to more hydrophilic. From \blx@tocontentsinit {0}\cite {wikicontacts}.}}{26}{figure.caption.37}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Examples of Newton rings formed in the interphase of Si/Si wafers. From \blx@tocontentsinit {0}\cite {nrings}.}}{27}{figure.caption.38}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Illustration of the razor blade method. A razor blade is inserted between the bonded surfaces in order to quantify the bonding energy between them. From \blx@tocontentsinit {0}\cite {mack1997}.}}{27}{figure.caption.39}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Schematic representation of water stress corrosion at the hydrophilic bonding interface during debonding under controlled atmospheres. Left: wet atmosphere showing ambient water attack on Si--O--Si bonds. Center: anhydrous (dry) atmosphere with reduced water availability. Right: vacuum conditions with partial desorption of interfacial water. Adapted from \blx@tocontentsinit {0}\cite {takeuchi2022}.}}{29}{figure.caption.44}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Schematic diagram of the tensile test setup for bonding strength measurement. The bonded wafer pair is glued to metal fixtures and subjected to perpendicular tensile force. Adapted from \blx@tocontentsinit {0}\cite {gosele2006}.}}{30}{figure.caption.46}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Energy level diagram showing the D1 and D2 transitions in an alkali metal atom. From \blx@tocontentsinit {0}\cite {shi2019}}}{31}{figure.caption.50}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Experimental setup used to detect Hanle resonance}}{34}{figure.caption.51}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Lorentzian profiles when (a) $B_z$ is varied and $B_y = 0$, (b) $B_y$ is varied and $B_z = 0$, and (c) $B_y$ and $B_z$ are varied simultaneously}}{35}{figure.caption.52}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Raw data and Lorentzian fit of the Hanle resonance obtained for the optimal DC field configuration ($B_y = \SI {0}{\nano \tesla }$, $B_z = \SI {4815}{\nano \tesla }$)}}{36}{figure.caption.53}%
