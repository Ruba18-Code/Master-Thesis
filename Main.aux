\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Optical micrograph of a fabricated LWVC showing its internal architecture: (a)~reservoir chamber, (b)~sensing channel, (c)~micro-strainer conduits, and (d)~overall structural outline. All cavities are inscribed in a single monolithic fused-silica block by the FLICE process. The overall size of the cell is \SI {5}{\milli \meter }$\times $\SI {10}{\milli \meter }, and the size of the microchannels is in the micrometer range.}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:lwvc_anatomy}{{1.6}{8}{Optical micrograph of a fabricated LWVC showing its internal architecture: (a)~reservoir chamber, (b)~sensing channel, (c)~micro-strainer conduits, and (d)~overall structural outline. All cavities are inscribed in a single monolithic fused-silica block by the FLICE process. The overall size of the cell is \SI {5}{\milli \meter }$\times $\SI {10}{\milli \meter }, and the size of the microchannels is in the micrometer range}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.7}{\ignorespaces Optical micrograph of the identical LWVC configuration following the physical integration of the NEG dispenser within the reservoir, captured prior to the optical contact bonding stage. The visible defects on the sample are a consequence of extensive prototyping and handling tests, and do not reflect the nominal fabrication quality.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:lwvc_neg}{{1.7}{9}{Optical micrograph of the identical LWVC configuration following the physical integration of the NEG dispenser within the reservoir, captured prior to the optical contact bonding stage. The visible defects on the sample are a consequence of extensive prototyping and handling tests, and do not reflect the nominal fabrication quality}{figure.caption.13}{}}
