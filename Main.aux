\@writefile{lof}{\contentsline {figure}{\numberline {1.9}{\ignorespaces Conceptual rendering of a femtosecond laser-written waveguide network embedded within a monolithic glass substrate. This maskless technique enables the direct 3D routing of light, establishing a technological foundation for fully monolithic atomic-photonic integration. Adapted from QSENSATO Srl \blx@tocontentsinit {0}\cite {qsensato_web}.}}{11}{figure.caption.15}\protected@file@percent }
\newlabel{fig:lw_waveguide}{{1.9}{11}{Conceptual rendering of a femtosecond laser-written waveguide network embedded within a monolithic glass substrate. This maskless technique enables the direct 3D routing of light, establishing a technological foundation for fully monolithic atomic-photonic integration. Adapted from QSENSATO Srl \cite {qsensato_web}}{figure.caption.15}{}}
